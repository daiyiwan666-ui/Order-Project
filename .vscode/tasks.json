{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动 V1.9 本地预览",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/dev-server.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "检查 V1.9 项目",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/check-project.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
